<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>15CEFlasher</AssemblyName>
    <RootNamespace>FifteenCEFlasher</RootNamespace>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.112</FileVersion>
    <InformationalVersion>1.2.0+112</InformationalVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <Product>15CE Flasher</Product>
    <Company>Mach II Labs</Company>
    <Description>Flash post-2015 Voyager calculator firmware on Windows</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
    <ItemGroup>
    <ProjectReference Include="..\FifteenCEFlasherCore\FifteenCEFlasherCore.csproj" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.svg" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>
